ECR_REGISTRY=public.ecr.aws/g8x9p1p0
FE_TAG=replace-with-frontend-commit-sha
BE_TAG=replace-with-backend-commit-sha
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.11

MYSQL_DATABASE=stockspoon
MYSQL_USER=stockspoon
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
TZ=Asia/Seoul

SPRING_PROFILES_ACTIVE=dev
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
DB_HOST=db
DB_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update

KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://example.com/auth/kakao/callback
FRONTEND_ORIGIN=http://example.com
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
KIWOOM_APP_KEY=replace-with-kiwoom-app-key
KIWOOM_APP_SECRET=replace-with-kiwoom-app-secret
KIWOOM_STREAM_ENABLED=true

NGINX_CPUS=0.30
NGINX_MEMORY_LIMIT=128m
FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=512m
BACKEND_CPUS=1.0
BACKEND_MEMORY_LIMIT=1500m
MYSQL_CPUS=0.75
MYSQL_MEMORY_LIMIT=1024m
