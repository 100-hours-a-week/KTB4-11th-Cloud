      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_slave_status_seconds_behind_source{job=~\"mysql-(primary|private-replica)\",db_node=~\"$node\",db_node!=\"\"} or mysql_slave_status_seconds_behind_master{job=~\"mysql-(primary|private-replica)\",db_node=~\"$node\",db_node!=\"\"}",
          "legendFormat": "{{db_node}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "수집 없음",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
