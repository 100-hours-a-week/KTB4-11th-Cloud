{
  "uid": "stockspoon-mysql-replication",
  "title": "MySQL · Primary & Replica",
  "description": "양쪽 MySQL의 연결·read_only·부하, native·heartbeat 복제 지연과 Fargate ProxySQL backend 상태를 비교한다. 알림 규칙은 Prometheus prometheus-rules/db-alerts.yml에 있다.",
  "tags": [
    "mysql",
    "replication",
    "stockspoon"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 41,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "refresh": 1,
        "hide": 2,
        "current": {},
        "options": []
      },
      {
        "name": "node",
        "label": "DB 노드",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(mysql_up{job=~\"mysql-(primary|private-replica)\"}, db_node)",
        "query": {
          "query": "label_values(mysql_up{job=~\"mysql-(primary|private-replica)\"}, db_node)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "MySQL 연결",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "mysql_up{job=~\"mysql-(primary|private-replica)\",db_node=~\"$node\",db_node!=\"\"}",
          "legendFormat": "{{db_node}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "연결 실패"
                },
                "1": {
                  "text": "정상"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      }
    },
