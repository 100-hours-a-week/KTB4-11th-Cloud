          "expr": "mysql_slave_status_replica_io_running{job=~\"mysql-(primary|private-replica)\",db_node=~\"$node\",db_node!=\"\"} or mysql_slave_status_slave_io_running{job=~\"mysql-(primary|private-replica)\",db_node=~\"$node\",db_node!=\"\"}",
