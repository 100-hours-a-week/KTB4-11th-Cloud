    {
      "id": 23,
      "type": "timeseries",
      "title": "DB 호스트 CPU 사용률 / I/O wait",
      "description": "node exporter가 본 DB 서버 전체 CPU 사용률과 I/O 대기 비율입니다. MySQL 프로세스 전용 CPU나 SQL 실행시간은 아닙니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * (1 - sum by (node_role) (rate(node_cpu_seconds_total{job=\"node\",node_role=~\"$node\",mode=\"idle\"}[5m])) / sum by (node_role) (rate(node_cpu_seconds_total{job=\"node\",node_role=~\"$node\"}[5m])))",
          "legendFormat": "{{node_role}} CPU 사용률",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * sum by (node_role) (rate(node_cpu_seconds_total{job=\"node\",node_role=~\"$node\",mode=\"iowait\"}[5m])) / sum by (node_role) (rate(node_cpu_seconds_total{job=\"node\",node_role=~\"$node\"}[5m]))",
          "legendFormat": "{{node_role}} I/O 대기",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "palette-classic"
          },
