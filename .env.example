# Public ECR registry alias. Do not append a trailing slash.
ECR_REGISTRY=public.ecr.aws/g8x9p1p0
FRONTEND_ECR_REPOSITORY=stockspoon-v1-frontend
BACKEND_ECR_REPOSITORY=stockspoon-v1-backend

# CI/CD replaces these values with immutable commit SHA tags.
FE_TAG=replace-with-frontend-commit-sha
BE_TAG=replace-with-backend-commit-sha

# Base images are pinned so upgrades are reviewed explicitly.
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4.11

# Store real passwords only in /opt/cloud/.env on EC2, never in Git.
DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=stockspoon
MYSQL_USER=stockspoon
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
TZ=Asia/Seoul

# Backend runtime configuration
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Temporary V1 schema strategy. Replace with validate after adding migrations.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Backend authentication configuration
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.com/auth/kakao/callback
FRONTEND_ORIGIN=https://example.com
# Set a unique runtime secret on EC2; never commit the real value.
JWT_SECRET=
AUTH_COOKIE_SECURE=true

# Container resource limits
NGINX_CPUS=0.30
NGINX_MEMORY_LIMIT=128m
FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=512m
BACKEND_CPUS=1.0
BACKEND_MEMORY_LIMIT=1500m
MYSQL_CPUS=0.75
MYSQL_MEMORY_LIMIT=1024m
