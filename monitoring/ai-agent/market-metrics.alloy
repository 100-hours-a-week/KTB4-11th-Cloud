// The development AI host publishes only its own private market-http listener.
discovery.relabel "dev_market_metrics" {
  targets = [{"__address__" = "127.0.0.1:9101", service_name = "market-http", environment = sys.env("DEPLOYMENT_ENVIRONMENT")}]
  rule {
    source_labels = ["environment"]
    regex = "dev"
    action = "keep"
  }
}

prometheus.scrape "market_metrics" {
  targets = discovery.relabel.dev_market_metrics.output
  scrape_interval = "15s"
  scrape_timeout = "5s"
  metrics_path = "/metrics"
  forward_to = [prometheus.relabel.market_metrics.receiver]
}

prometheus.relabel "market_metrics" {
  forward_to = [prometheus.remote_write.server.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "market_http_sse_active_connections|market_http_sse_connections|market_http_sse_connections_(started|closed)_total|market_http_sse_events_sent(_bytes)?_total|market_http_sse_delivery_latency_seconds_(bucket|sum|count)|market_http_valkey_pool_connections|market_http_valkey_pool_acquire_duration_seconds_(bucket|sum|count)|market_http_valkey_pool_acquire_timeouts_total|market_http_sse_live_events_sent_total|market_http_pubsub_(messages_received|payload_received_bytes)_total|market_http_sse_queues|market_http_sse_queue_(events|max_events|high_watermark_events|payload_bytes|(full|discarded_events)_total)|market_http_sse_slow_subscribers_closed_total|market_http_sse_(send_operations_in_flight|send_body_bytes_in_flight|observer_buffer_bytes|delivery_markers_pending)|process_(resident_memory_bytes|virtual_memory_bytes|cpu_seconds_total|start_time_seconds|open_fds|max_fds)|up"
    action = "keep"
  }
  rule {
    target_label = "job"
    replacement = "market-http-metrics"
  }
}
