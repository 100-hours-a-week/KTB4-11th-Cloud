  "refresh": "",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "stockspoon"
      ],
      "asDropdown": true,
      "title": "Stockspoon 대시보드"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "ECS 서비스",
        "type": "custom",
        "query": "stockspoon-v2-prod-market-http,stockspoon-v2-prod-backend,stockspoon-v2-prod-backend-collector,stockspoon-v2-prod-frontend",
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "stockspoon-v2-prod-market-http",
            "value": "stockspoon-v2-prod-market-http",
