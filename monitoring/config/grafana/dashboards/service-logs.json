{
  "uid": "stockspoon-service-logs",
  "title": "Stockspoon 서비스 로그 분석",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "stockspoon",
    "telemetry"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "트레이스 조회 (Tempo)",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22traces%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%20resource.deployment.environment.name%20%3D~%20%5C%22${environment:regex}%5C%22%20%7D%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "환경",
        "type": "custom",
        "query": "dev,prod",
        "multi": true,
        "includeAll": true,
        "allValue": "dev|prod",
        "options": [
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          }
        ],
        "current": {
          "text": [
            "prod"
          ],
          "value": [
            "prod"
          ]
        }
      },
      {
        "name": "cluster",
        "label": "클러스터",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({environment=~\"$environment\"}, cluster)",
        "definition": "label_values({environment=~\"$environment\"}, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "options": [],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({environment=~\"$environment\",cluster=~\"$cluster\"}, service_name)",
        "definition": "label_values({environment=~\"$environment\",cluster=~\"$cluster\"}, service_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "options": [],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "서비스별 로그 발생률",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name) (rate({environment=~\"$environment\",cluster=~\"$cluster\",service_name=~\"$service\"}[$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "서비스별 오류·예외 로그 (5분)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name) (count_over_time({environment=~\"$environment\",cluster=~\"$cluster\",service_name=~\"$service\"} |~ \"(?i)error|exception|fatal\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "서비스별 경고 로그 (5분)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service_name) (count_over_time({environment=~\"$environment\",cluster=~\"$cluster\",service_name=~\"$service\"} |~ \"(?i)warn\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "오류·예외 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\",cluster=~\"$cluster\",service_name=~\"$service\"} |~ \"(?i)error|exception|fatal\"",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "전체 서비스 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\",cluster=~\"$cluster\",service_name=~\"$service\"}",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "description": "로그 기반 지표입니다. HTTP 요청 오류율이나 Task 자원 사용률을 나타내지 않습니다."
}
