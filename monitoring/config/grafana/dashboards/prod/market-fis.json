          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "테스트 발행기 · 마지막 성공 발행 후 경과 시간",
      "description": "최초 성공 전은 NaN입니다. 값이 없는 상태를 0으로 대체하지 않습니다.",
