{
  "uid": "stockspoon-market-fis",
  "title": "시세 FIS · 테스트 발행·큐·전달 관측",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "stockspoon",
    "prod",
    "fis"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "graphTooltip": 1,
  "links": [
    {
      "type": "link",
      "title": "기본 시세 서버 대시보드",
      "url": "/d/stockspoon-ecs-sse",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "테스트 발행 publish 트레이스",
      "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B+resource.service.name+%3D+%5C%22test-streamer%5C%22+%26%26+name+%3D+%5C%22publish%5C%22+%7D%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
    },
    {
      "type": "link",
      "title": "시세 deliver 트레이스",
      "url": "/explore?schemaVersion=1&panes=%7B%22trace%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B+resource.service.name+%3D+%5C%22market-http%5C%22+%26%26+name+%3D+%5C%22deliver%5C%22+%7D%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "task",
        "label": "시세 Task",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{environment=\"prod\",job=\"market-http-metrics\"}, task_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [],
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "테스트 발행기 · 메트릭 수집 상태",
      "description": "1은 수집 성공, 0은 중지 또는 실패입니다. 테스트 발행기는 수동 실행하며 미실행 상태를 정상 발행으로 표시하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\"}",
          "legendFormat": "test-streamer",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "테스트 발행기 · 실제 발행량과 목표 EPS",
      "description": "실제 발행량은 Valkey의 배치 응답을 확인한 이벤트 수입니다. SSE 클라이언트 수신 성공 건수와 다릅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind) (rate(test_streamer_published_events_total{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} 확인된 발행",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by(kind) (test_streamer_target_events_per_second{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\"})",
          "legendFormat": "{{kind}} 목표",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "테스트 발행기 · 발행 payload 바이트 / 초",
      "description": "UTF-8 JSON payload 기준이며 Redis 프로토콜 바이트와 SET 저장 바이트의 중복은 포함하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind) (rate(test_streamer_published_payload_bytes_total{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "테스트 발행기 · 배치 오류와 확인되지 않은 이벤트",
      "description": "배치 오류 시 일부 SET/PUBLISH가 이미 실행됐을 수 있습니다. 미확인 이벤트를 전부 유실되었다고 해석하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(test_streamer_publish_batches_total{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\",result=\"error\"}[$__rate_interval]))",
          "legendFormat": "배치 오류 / 초",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(kind) (rate(test_streamer_publish_unconfirmed_events_total{environment=\"prod\",service_name=\"test-streamer\",source=\"test-streamer\",job=\"test-streamer-metrics\"}[$__rate_interval]))",
