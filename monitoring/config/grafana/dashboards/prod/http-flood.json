        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{environment=\"prod\",job=\"backend-metrics\",service_name=\"backend\",task_id!=\"\"}",
          "legendFormat": "{{task_id}} pending",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "ECS Backend · Task CPU (코어)",
      "description": "Task별 컨테이너 CPU 사용량입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(task_id) (rate(container_cpu_usage_seconds_total{environment=\"prod\",cluster=\"stockspoon-v2-prod-cluster\",ecs_service=\"stockspoon-v2-prod-backend\",task_id!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{task_id}}",
          "range": true
