  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. 엣지에서 WAF가 감지·차단했는가",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "WAF API rate rule · Count 감지 / Block 차단 (분당)",
      "description": "CountedRequests는 rate rule이 기준 초과 요청에 매칭된 수입니다. 전체 API 요청 수가 아닙니다. Count 모드에서는 감지, Block 모드에서는 차단 지표를 확인하세요. Terraform 기본값은 IP당 300초에 500회이며, 실제 적용값은 Apply 후 확인하세요. CloudFront WAF 지표는 us-east-1에서 약 1분 간격으로 보고됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "us-east-1",
          "namespace": "AWS/WAFV2",
          "metricName": "CountedRequests",
          "statistic": "Sum",
          "dimensions": {
            "WebACL": "stockspoon-api-rate-limit",
            "Rule": "stockspoon-api-per-source-ip"
          },
          "period": "60",
          "label": "Count 매칭",
          "matchExact": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "us-east-1",
          "namespace": "AWS/WAFV2",
          "metricName": "BlockedRequests",
          "statistic": "Sum",
          "dimensions": {
            "WebACL": "stockspoon-api-rate-limit",
            "Rule": "stockspoon-api-per-source-ip"
          },
          "period": "60",
          "label": "Block 차단",
          "matchExact": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "CloudFront · 전체 배포 요청 수 (분당)",
      "description": "정적 파일과 웹 페이지 요청을 포함한 배포 전체 요청 수입니다. /api/ 요청만의 수치는 아닙니다.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "us-east-1",
          "namespace": "AWS/CloudFront",
          "metricName": "Requests",
          "statistic": "Sum",
          "dimensions": {
            "DistributionId": "E2Y9S3V9X3DRMW",
            "Region": "Global"
          },
          "period": "60",
          "label": "전체 요청",
          "matchExact": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "CloudFront · 4xx / 5xx 비율",
      "description": "엣지 오류 추세를 확인합니다. WAF Block 응답도 4xx에 반영될 수 있지만, 차단 여부의 기준 지표는 위 WAF BlockedRequests입니다. CloudFront 전체 배포 기준입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "us-east-1",
          "namespace": "AWS/CloudFront",
          "metricName": "4xxErrorRate",
          "statistic": "Average",
          "dimensions": {
            "DistributionId": "E2Y9S3V9X3DRMW",
            "Region": "Global"
          },
          "period": "60",
          "label": "4xx",
          "matchExact": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "queryMode": "Metrics",
          "region": "us-east-1",
          "namespace": "AWS/CloudFront",
          "metricName": "5xxErrorRate",
          "statistic": "Average",
          "dimensions": {
            "DistributionId": "E2Y9S3V9X3DRMW",
            "Region": "Global"
          },
          "period": "60",
          "label": "5xx",
          "matchExact": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
