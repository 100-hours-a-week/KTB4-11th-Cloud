    "prod",
    "security",
    "http-flood"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "stockspoon"
      ],
      "asDropdown": true,
      "title": "Stockspoon 운영 대시보드"
    }
  ],
  "templating": {
    "list": []
