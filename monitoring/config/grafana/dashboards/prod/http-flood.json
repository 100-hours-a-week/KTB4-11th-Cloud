          },
          "queryMode": "Metrics",
          "region": "ap-northeast-2",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "statistic": "Sum",
          "dimensions": {
            "LoadBalancer": "app/stockspoon-v1-alb/ebcc17bb6129bafc",
            "TargetGroup": "targetgroup/stockspoon-v2-prod-backend-green/6e3ed88eada0cd60"
          },
          "period": "60",
          "label": "Backend 요청",
