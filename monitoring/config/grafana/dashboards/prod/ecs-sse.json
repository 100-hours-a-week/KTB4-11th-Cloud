    {
      "id": 20,
      "title": "market-http · Task별 CPU 사용 코어",
      "description": "1은 CPU 코어 1개 사용량입니다. Task 예약 CPU 대비 백분율이 아닙니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(task_id,service_name) (rate(container_cpu_usage_seconds_total{environment=\"prod\",cluster=\"stockspoon-v2-prod-cluster\",ecs_service=\"stockspoon-v2-prod-market-http\",task_id!=\"\"}[2m]))",
          "legendFormat": "{{service_name}} / {{task_id}}",
          "range": true,
          "datasource": {
