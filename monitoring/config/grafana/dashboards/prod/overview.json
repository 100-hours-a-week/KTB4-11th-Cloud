            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{environment=\"prod\",cluster=~\"$cluster\",instance=~\"$instance\",job=\"integrations/unix\"})",
          "datasource": {
