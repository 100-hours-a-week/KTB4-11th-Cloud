        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(node_network_receive_bytes_total{environment=\"prod\",cluster=~\"$cluster\",instance=~\"$instance\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval]))",
