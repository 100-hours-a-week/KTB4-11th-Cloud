          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(uri,method)(rate(http_server_requests_seconds_count{environment=\"prod\",job=\"backend-metrics\",service_name=\"backend\",task_id!=\"\",uri!~\"/actuator.*\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
