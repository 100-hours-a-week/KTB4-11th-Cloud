      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "미수집 / 이벤트 없음"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
