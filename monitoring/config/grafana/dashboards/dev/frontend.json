{
  "uid": "stockspoon-dev-frontend",
  "title": "Stockspoon 개발 FE 모니터링",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "dev",
    "stockspoon",
    "telemetry"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "type": "link",
      "title": "개발 FE",
      "url": "/d/stockspoon-dev-frontend",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "개발 BE",
      "url": "/d/stockspoon-dev-backend",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "개발 호스트",
      "url": "/d/stockspoon-dev-overview",
      "keepTime": true
    },
    {
      "type": "link",
      "title": "개발 전체 로그",
      "url": "/d/stockspoon-dev-service-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "FE 로그 발생률",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host_role,service_name) (rate({environment=\"dev\",host_role=\"app\",cluster=\"stockspoon-v2-dev\",service_name=\"frontend\"}[$__auto]))",
          "queryType": "range",
          "legendFormat": "{{host_role}} / {{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "FE 오류·예외 로그 (5분)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host_role,service_name) (count_over_time({environment=\"dev\",host_role=\"app\",cluster=\"stockspoon-v2-dev\",service_name=\"frontend\"} |~ \"(?i)error|exception|fatal\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{host_role}} / {{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "FE 경고 로그 (5분)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(host_role,service_name) (count_over_time({environment=\"dev\",host_role=\"app\",cluster=\"stockspoon-v2-dev\",service_name=\"frontend\"} |~ \"(?i)warn\" [5m]))",
          "queryType": "range",
          "legendFormat": "{{host_role}} / {{service_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "오류·예외 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"dev\",host_role=\"app\",cluster=\"stockspoon-v2-dev\",service_name=\"frontend\"} |~ \"(?i)error|exception|fatal\"",
          "queryType": "range",
          "legendFormat": "{{host_role}} / {{service_name}}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "FE 전체 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"dev\",host_role=\"app\",cluster=\"stockspoon-v2-dev\",service_name=\"frontend\"}",
          "queryType": "range",
          "legendFormat": "{{host_role}} / {{service_name}}"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "description": "개발 FE 전용 로그. 로그 발생률은 요청량이 아닙니다. 공유 EC2 자원은 개발 호스트에서 확인하세요."
}
