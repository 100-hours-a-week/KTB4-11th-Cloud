{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "stockspoon-hosts",
      "folder": "Stockspoon",
      "interval": "1m",
      "rules": [
        {
          "uid": "stockspoon-host-cpu",
          "title": "호스트 CPU 85% 초과",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "100 * (1 - avg by(environment,cluster,instance) (rate(node_cpu_seconds_total{environment=\"prod\",mode=\"idle\"}[5m])))",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        85
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "호스트 CPU 85% 초과",
            "description": "호스트 지표 기준입니다. 수집 중단 시 ECS 교체·ASG 축소와 Alloy 상태를 함께 확인하세요."
          }
        },
        {
          "uid": "stockspoon-host-memory",
          "title": "호스트 메모리 90% 초과",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "100 * (1 - node_memory_MemAvailable_bytes{environment=\"prod\"} / node_memory_MemTotal_bytes{environment=\"prod\"})",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        90
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "호스트 메모리 90% 초과",
            "description": "호스트 지표 기준입니다. 수집 중단 시 ECS 교체·ASG 축소와 Alloy 상태를 함께 확인하세요."
          }
        },
        {
          "uid": "stockspoon-host-disk",
          "title": "호스트 디스크 85% 초과",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "100 * (1 - node_filesystem_avail_bytes{environment=\"prod\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/run.*|/var/lib/docker.*\"} / node_filesystem_size_bytes{environment=\"prod\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs\",mountpoint!~\"/run.*|/var/lib/docker.*\"})",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        85
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "호스트 디스크 85% 초과",
            "description": "호스트 지표 기준입니다. 수집 중단 시 ECS 교체·ASG 축소와 Alloy 상태를 함께 확인하세요."
          }
        },
        {
          "uid": "stockspoon-host-scrape",
          "title": "운영 호스트 수집 실패",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "1 - up{environment=\"prod\",job=\"integrations/unix\"}",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "운영 호스트 수집 실패",
            "description": "호스트 지표 기준입니다. 수집 중단 시 ECS 교체·ASG 축소와 Alloy 상태를 함께 확인하세요."
          }
        },
        {
          "uid": "stockspoon-prod-metrics-missing",
          "title": "운영 호스트 지표 전체 유실",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "absent_over_time(node_uname_info{environment=\"prod\",cluster=\"stockspoon-v2-prod-cluster\"}[5m]) or vector(0)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "운영 호스트 지표 전체 유실",
            "description": "호스트 지표 기준입니다. 수집 중단 시 ECS 교체·ASG 축소와 Alloy 상태를 함께 확인하세요."
          }
        },
        {
          "uid": "stockspoon-error-logs",
          "title": "운영 AI EC2 오류 로그 급증",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "datasourceUid": "loki",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "loki",
                  "uid": "loki"
                },
                "expr": "sum by(environment,cluster,service_name) (count_over_time({environment=\"prod\",host_role=\"ai\"} |~ \"(?i)error|exception|fatal\" [5m]))",
                "queryType": "instant",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "isPaused": true,
          "labels": {
            "managed_by": "stockspoon",
            "environment": "prod",
            "severity": "warning"
          },
          "annotations": {
            "summary": "운영 AI EC2 오류 로그 급증",
            "description": "최근 5분 error/exception/fatal 일치 로그가 20건을 초과한 상태가 5분 지속됩니다. HTTP 오류율이 아니며 같은 예외가 여러 줄로 집계될 수 있습니다."
          }
        }
      ]
    }
  ]
}
