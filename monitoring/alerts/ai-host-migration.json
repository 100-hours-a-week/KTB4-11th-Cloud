{
  "folder": "Stockspoon",
  "group": "stockspoon-prod-ai-host",
  "interval": 60,
  "receiver": "stockspoon-discord-ai-host",
  "secret_id": "stockspoon/v1/ai/discord-webhook",
  "rules": [
    {
      "uid": "stockspoon-ai-host-cpu",
      "title": "ai-v1 CPU 85% 이상",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "sum_over_time(((100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\",mode=\"idle\"}[1m])))) >= bool 85)[5m:1m])",
            "instant": true,
            "range": false,
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2.5
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": false,
      "labels": {
        "managed_by": "stockspoon",
        "environment": "prod",
        "severity": "warning",
        "cluster": "stockspoon-v1-ai",
        "host_role": "ai"
      },
      "annotations": {
        "summary": "ai-v1 CPU 85% 이상",
        "description": "최근 5개 1분 표본 중 3개가 85% 이상이면 경고합니다. CloudWatch와 수집기·샘플 경계가 달라 판정 시각은 동일하지 않을 수 있습니다."
      },
      "ruleGroup": "stockspoon-prod-ai-host",
      "orgId": 1,
      "notification_settings": {
        "receiver": "stockspoon-discord-ai-host"
      }
    },
    {
      "uid": "stockspoon-ai-host-memory",
      "title": "ai-v1 메모리 85% 이상",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "sum_over_time(((100 * (node_memory_MemTotal_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"} - node_memory_MemFree_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"} - node_memory_Buffers_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"} - node_memory_Cached_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"} - node_memory_SReclaimable_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"}) / node_memory_MemTotal_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"}) >= bool 85)[5m:1m])",
            "instant": true,
            "range": false,
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2.5
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": false,
      "labels": {
        "managed_by": "stockspoon",
        "environment": "prod",
        "severity": "warning",
        "cluster": "stockspoon-v1-ai",
        "host_role": "ai"
      },
      "annotations": {
        "summary": "ai-v1 메모리 85% 이상",
        "description": "최근 5개 1분 표본 중 3개가 85% 이상이면 경고합니다. CloudWatch와 수집기·샘플 경계가 달라 판정 시각은 동일하지 않을 수 있습니다."
      },
      "ruleGroup": "stockspoon-prod-ai-host",
      "orgId": 1,
      "notification_settings": {
        "receiver": "stockspoon-discord-ai-host"
      }
    },
    {
      "uid": "stockspoon-ai-host-disk",
      "title": "ai-v1 루트 디스크 85% 이상",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "sum_over_time(((100 * (node_filesystem_size_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\",mountpoint=\"/\",fstype=\"ext4\"} - node_filesystem_free_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\",mountpoint=\"/\",fstype=\"ext4\"}) / node_filesystem_size_bytes{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\",mountpoint=\"/\",fstype=\"ext4\"}) >= bool 85)[5m:1m])",
            "instant": true,
            "range": false,
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    4.5
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": false,
      "labels": {
        "managed_by": "stockspoon",
        "environment": "prod",
        "severity": "warning",
        "cluster": "stockspoon-v1-ai",
        "host_role": "ai"
      },
      "annotations": {
        "summary": "ai-v1 루트 디스크 85% 이상",
        "description": "최근 5개 1분 표본 중 5개가 85% 이상이면 경고합니다. CloudWatch와 수집기·샘플 경계가 달라 판정 시각은 동일하지 않을 수 있습니다."
      },
      "ruleGroup": "stockspoon-prod-ai-host",
      "orgId": 1,
      "notification_settings": {
        "receiver": "stockspoon-discord-ai-host"
      }
    },
    {
      "uid": "stockspoon-prod-ai-metrics-missing",
      "title": "운영 ai-v1 호스트 지표 유실",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "prometheus",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "model": {
            "refId": "A",
            "expr": "absent_over_time(node_uname_info{environment=\"prod\",cluster=\"stockspoon-v1-ai\",host_role=\"ai\"}[5m]) or vector(0)",
            "instant": true,
            "range": false,
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": false,
      "labels": {
        "managed_by": "stockspoon",
        "environment": "prod",
        "severity": "warning",
        "cluster": "stockspoon-v1-ai",
        "host_role": "ai"
      },
      "annotations": {
        "summary": "운영 ai-v1 호스트 지표 유실",
        "description": "ai-v1의 Alloy 호스트 지표가 5분 동안 없으면 알립니다. ECS 클러스터 지표로 대체하지 않습니다."
      },
      "ruleGroup": "stockspoon-prod-ai-host",
      "orgId": 1,
      "notification_settings": {
        "receiver": "stockspoon-discord-ai-host"
      }
    }
  ],
  "cloudwatch_alarms": [
    "stockspoon-v1-ai-cpu-high",
    "stockspoon-v1-ai-memory-used-high",
    "stockspoon-v1-ai-root-disk-high",
    "stockspoon-v1-ai-metrics-missing"
  ]
}
